<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8E9"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#2E7D32"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personalise your Smart Pantry experience"
            android:textSize="15sp"
            android:layout_marginBottom="24dp"/>
        <Switch
            android:id="@+id/switchExpiryAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show expiring-soon warnings"
            android:textSize="16sp"
            android:checked="true"
            android:padding="12dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Warnings appear on pantry items that expire within 3 days."
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>
        <Button
            android:id="@+id/btnSettingsPantry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Go to My Pantry"/>
        <Button
            android:id="@+id/btnSettingsRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Go to Suggested Recipes"/>
        <Button
            android:id="@+id/btnSettingsHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Back to Home"/>
    </LinearLayout>
</ScrollView>
